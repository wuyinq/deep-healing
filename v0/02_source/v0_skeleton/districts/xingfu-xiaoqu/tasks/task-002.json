    { "from": "invited", "to": "shared", "trigger": "npc.action#npc-003", "condition": "action==talk" },
    { "from": "shared", "to": "ritual", "trigger": "npc.action#npc-005", "condition": "action==sit_regularly" }
  ],
  "adaptation_rules": [
    {
      "id": "rule-002-pace",
      "match": { "event_type": "intent.applied", "kind": "delegate_instruction", "target": "npc-005" },
